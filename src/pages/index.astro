---
// src/pages/index.astro
import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import AudioEmbed from '../components/AudioEmbed.astro';
import DedicationCard from '../components/DedicationCard.astro';
import DedicationPlus from '../components/DedicationPlus.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import DedicationTools from '../components/DedicationTools.astro';
import Icon from '../components/Icon.astro';
import DedicationLetter from '../components/DedicationLetter.astro';

const dataDir = join(process.cwd(), 'data', 'dedications');
const todayPath = join(process.cwd(), 'data', 'today.json');

// Carica tutte le dediche pubblicate ordinate per data
let all: any[] = [];
if (existsSync(dataDir)) {
  const files = readdirSync(dataDir).filter(f => f.endsWith('.json')).sort();
  all = files.map(f => JSON.parse(readFileSync(join(dataDir, f), 'utf-8')));
}

let promotedToday: any = null;
if (existsSync(todayPath)) {
  promotedToday = JSON.parse(readFileSync(todayPath, 'utf-8'));
}

const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });

// La dedica piu recente con date <= oggi e status published/scheduled
const published = all
  .filter(d => d.status === 'published' && d.date <= today)
  .sort((a, b) => {
    const byDate = b.date.localeCompare(a.date);
    if (byDate !== 0) return byDate;
    const byOrder = String(a.daily_order ?? '').localeCompare(String(b.daily_order ?? ''));
    if (byOrder !== 0) return byOrder;
    return String(a.id ?? '').localeCompare(String(b.id ?? ''));
  });

const dedication = promotedToday?.status === 'published' && promotedToday.date <= today
  ? promotedToday
  : published[0] ?? null;

// Ultime 4 dediche (esclusa quella in hero)
const recent = published
  .filter(d => d.id !== dedication?.id)
  .slice(0, 4);

const base = (import.meta.env.BASE_URL ?? '/').replace(/([^/])$/, '$1/');
const whatsappUrl = 'https://wa.me/393346296520';

function fmtDate(dateStr: string, dayName?: string) {
  const [y, m, d] = dateStr.split('-');
  const months = ['gennaio','febbraio','marzo','aprile','maggio','giugno','luglio','agosto','settembre','ottobre','novembre','dicembre'];
  const label = `${parseInt(d)} ${months[parseInt(m)-1]} ${y}`;
  return dayName ? `${dayName}, ${label}` : label;
}
---

<BaseLayout
  title="DDGPilliSite - Dediche Musicali"
  description="Una nuova dedica musicale ogni giorno. Ascolta, senti, condividi."
  ogTitle="DDGPilliSite - Dediche Musicali"
  ogDescription="Una nuova dedica musicale ogni giorno. Ascolta, senti, condividi."
  ogImage="/images/og-default.png"
  enableBackgroundMusic={true}
>

  <section class="music-hero">
    <div class="cinematic-light cinematic-light-one" aria-hidden="true"></div>
    <div class="cinematic-light cinematic-light-two" aria-hidden="true"></div>
    <div class="film-grain" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-topline">
        <p class="journal-label">La nostra vita, in musica</p>
        <span class="journal-count">{published.length} canzoni. Infinite emozioni.</span>
      </div>
      {dedication ? (
        <div class="music-stage">
          <div class="music-story">
            <div class="story-heading" data-cinema-enter>
            <p class="hero-date">{fmtDate(dedication.date, dedication.day_name)}</p>
            <h1 class="music-title" transition:name={`dedication-title-${dedication.id}`}>{dedication.song_title}</h1>
            <p class="music-artist">{dedication.artist}</p>
            </div>
            <div class="story-body">
            <DedicationLetter title={dedication.dedication_title} text={dedication.dedication_text} phrase={dedication.short_phrase} />
            <div class="stage-actions">
              <a href={dedication.audio.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-audio-play><Icon name="play" /> Ascolta</a>
              <DedicationPlus dedication={dedication} mode="button" />
              <a href={dedication.vote?.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-site-config-target="googleVote">&#9733; Votami</a>
            </div>
            <div class="stage-extras">
              <DedicationTools dedication={dedication} />
              <a href={`${base}dediche/${dedication.id}/`} class="text-link">Leggi tutto <Icon name="arrow" size={16} /></a>
            </div>
            <div class="stage-extras">
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Contattami su WhatsApp ↗</a>
              <a href={`${base}link-utili/`}>Link utili ↗</a>
            </div>
            </div>
          </div>
          <div class="music-art" data-cinema-enter>
            <div class="art-stamp" aria-hidden="true">UNA CANZONE<strong>per te</strong>OGNI GIORNO</div>
            {dedication.image?.path ? (
              <div class="hero-image-frame" id="hero-image-frame" transition:name={`dedication-art-${dedication.id}`}>
                <img src={base + dedication.image.path.replace(/^\//, '')} alt={dedication.image.alt ?? ''} class="hero-image" width="600" height="650" loading="eager" decoding="async" fetchpriority="high" />
                <span class="photo-sheen" aria-hidden="true"></span>
                {dedication.short_phrase && <div class="art-caption"><span>Le parole che restano</span><p>{dedication.short_phrase}</p></div>}
              </div>
            ) : <div class="img-placeholder" aria-label="Dedica musicale">♫</div>}
            <DedicationPlus dedication={dedication} mode="reactions" />
          </div>
        </div>
      ) : (
        <div class="music-story"><h1 class="music-title">La prossima emozione<br />sta arrivando.</h1><p class="music-artist">Nel frattempo, ritrova una canzone nell'archivio.</p><a href={`${base}archive/`} class="btn btn-primary">Esplora le dediche</a></div>
      )}
    </div>
  </section>
  {dedication && (
    <>
      <section class="listening-room" id="ascolto">
        <div class="container">
          <div><span class="journal-label">Premi play. Resta qui.</span><h2>Il resto può aspettare.</h2><p>Una canzone, le nostre parole, questo momento.</p></div>
          <AudioEmbed url={dedication.audio.url} type={dedication.audio.type} sourceType={dedication.audio.source_type} mimeType={dedication.audio.mime_type} originalFilename={dedication.audio.original_filename} />
        </div>
      </section>
      <DedicationTools dedication={dedication} dock />
    </>
  )}

  {dedication?.video && (
    <section style="padding:2rem 0 3rem;background:var(--bg-surface);">
      <div class="container-narrow reveal">
        <VideoEmbed
          type={dedication.video.type}
          url={dedication.video.url}
          poster={dedication.video.poster}
          title={dedication.video.title || 'Video della dedica'}
          description={dedication.video.description}
        />
      </div>
    </section>
  )}

  <!-- RECENT DEDICHE -->
  {recent.length > 0 && (
    <section class="collection-section">
      <div class="container">
        <div class="collection-heading reveal">
          <div><span class="journal-label">La nostra colonna sonora</span><h2>Ogni canzone,<br />un pezzo di noi.</h2></div>
          <a href={`${base}archive/`} class="text-link">Esplora tutte le dediche <Icon name="arrow" /></a>
        </div>
        <div class="archive-grid reveal">
          {recent.map((d: any) => (
            <DedicationCard
              id={d.id}
              date={d.date}
              day_name={d.day_name}
              song_title={d.song_title}
              artist={d.artist}
              image={d.image}
              tags={d.tags}
              dedication_text={d.dedication_text}
              short_phrase={d.short_phrase}
            />
          ))}
        </div>
        <div style="text-align:center;margin-top:3rem;" class="reveal">
          <a href={`${base}archive/`} class="btn btn-secondary">
            Vedi tutto l'archivio &rarr;
          </a>
        </div>
      </div>
    </section>
  )}

</BaseLayout>
