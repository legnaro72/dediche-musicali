---
// src/pages/archive/index.astro
import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DedicationCard from '../../components/DedicationCard.astro';
import Icon from '../../components/Icon.astro';

const dataDir = join(process.cwd(), 'data', 'dedications');
const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });

let all: any[] = [];
if (existsSync(dataDir)) {
  const files = readdirSync(dataDir).filter(f => f.endsWith('.json')).sort().reverse();
  all = files
    .map(f => JSON.parse(readFileSync(join(dataDir, f), 'utf-8')))
    .filter(d => d.status === 'published' && d.date <= today)
    .sort((a, b) => {
      const byDate = b.date.localeCompare(a.date);
      if (byDate !== 0) return byDate;
      const byOrder = String(a.daily_order ?? '').localeCompare(String(b.daily_order ?? ''));
      if (byOrder !== 0) return byOrder;
      return String(a.id ?? '').localeCompare(String(b.id ?? ''));
    });
}

// Ricava liste per filtri
const artists = [...new Set(all.map(d => d.artist))].sort();
const months = [...new Set(all.map(d => d.date.substring(0, 7)))].sort().reverse();
const MONTH_NAMES: Record<string, string> = {
  '01':'Gennaio','02':'Febbraio','03':'Marzo','04':'Aprile',
  '05':'Maggio','06':'Giugno','07':'Luglio','08':'Agosto',
  '09':'Settembre','10':'Ottobre','11':'Novembre','12':'Dicembre'
};
---

<BaseLayout
  title="Archivio Dediche | DDGPilliSite"
  description="Tutte le dediche musicali pubblicate su DDGPilliSite. Cerca, filtra e rileggi ogni dedica."
>

<section class="archive-page" data-archive>
  <div class="container">
    <header class="archive-heading">
      <span class="journal-label">Tutte le nostre emozioni</span>
      <h1>La musica resta.</h1>
      <p>{all.length} dediche da ritrovare. Cerca una canzone, un artista o una parola che ricordi.</p>
    </header>
    <div class="archive-filters">
      <label>Cerca una dedica<input type="search" id="search-input" class="search-bar" placeholder="Canzone, artista, parole…" autocomplete="off" /></label>
      <label>Artista<select id="filter-artist" class="filter-select"><option value="">Tutti gli artisti</option>{artists.map(a => <option value={a}>{a}</option>)}</select></label>
      <label>Mese<select id="filter-month" class="filter-select"><option value="">Tutti i mesi</option>{months.map(m => { const [y, mo] = m.split('-'); return <option value={m}>{MONTH_NAMES[mo]} {y}</option>; })}</select></label>
    </div>
    <div class="archive-toolbar">
      <button class="tool-button" type="button" data-favorites-filter aria-pressed="false"><Icon name="heart" size={17} /> Preferiti</button>
      <button class="tool-button" type="button" data-surprise><Icon name="shuffle" size={17} /> Sorprendimi</button>
      <button class="tool-button" type="button" data-reset-filters>Azzera filtri</button>
      <p class="archive-count" data-results-count role="status" aria-live="polite">{all.length} dediche</p>
    </div>
    <!-- Grid -->
    <div class="archive-grid" id="archive-grid">
      {all.map((d: any) => (
        <DedicationCard
          id={d.id}
          date={d.date}
          day_name={d.day_name}
          song_title={d.song_title}
          artist={d.artist}
          image={d.image}
          tags={d.tags}
          dedication_text={d.dedication_text}
          short_phrase={d.short_phrase}
        />
      ))}
    </div>

    <div id="no-result" class="archive-empty" hidden>
      <h2>Nessuna dedica, per ora.</h2>
      <p>Prova altre parole oppure salva una dedica con il cuore.<br />I preferiti sono conservati solo su questo dispositivo.</p>
      <button class="btn btn-secondary" type="button" data-reset-filters>Mostra tutte le dediche</button>
    </div>
  </div>
</section>
<script>
  import '../../scripts/archive.js';
</script>
</BaseLayout>
