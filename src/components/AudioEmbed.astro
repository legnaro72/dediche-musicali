---
// src/components/AudioEmbed.astro
import Icon from './Icon.astro';
export interface Props {
  url: string;
  type?: string; // campo storico: spotify | youtube | soundcloud | mp3 | cloud | other
  sourceType?: string; // spotify | external_url | uploaded_audio
  mimeType?: string;
  originalFilename?: string;
}

const { url, type = 'other', sourceType, mimeType = '', originalFilename = '' } = Astro.props;
const normalizedSourceType = sourceType || (type === 'spotify' ? 'spotify' : 'external_url');

function getSpotifyEmbedUrl(url: string): string | null {
  const m = url.match(/spotify\.com\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?(track|album|playlist|episode)\/([a-zA-Z0-9]+)/i);
  if (!m) return null;
  return `https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=generator&theme=0`;
}

function getYoutubeEmbedUrl(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/);
  if (!m) return null;
  return `https://www.youtube.com/embed/${m[1]}?rel=0`;
}

function getSoundcloudEmbedUrl(url: string): string | null {
  if (!url.includes('soundcloud.com')) return null;
  return `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%237c3aed&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=true`;
}

let embedUrl: string | null = null;
let embedHeight = 152;

if (type === 'spotify') {
  embedUrl = getSpotifyEmbedUrl(url);
  embedHeight = 152;
} else if (type === 'youtube') {
  embedUrl = getYoutubeEmbedUrl(url);
  embedHeight = 315;
} else if (type === 'soundcloud') {
  embedUrl = getSoundcloudEmbedUrl(url);
  embedHeight = 300;
}

const extension = url.split('?')[0].toLowerCase().match(/\.([a-z0-9]+)$/)?.[1] ?? '';
const audioMime = mimeType.toLowerCase();
const directAudio = normalizedSourceType !== 'spotify'
  && (
    normalizedSourceType === 'uploaded_audio'
    || audioMime.startsWith('audio/')
    || ['mp3', 'm4a', 'aac', 'ogg', 'opus', 'wav', 'webm'].includes(extension)
    || type === 'mp3'
  );
const fallbackMime = audioMime || ({ mp3: 'audio/mpeg', m4a: 'audio/mp4', aac: 'audio/aac', ogg: 'audio/ogg', opus: 'audio/ogg', wav: 'audio/wav', webm: 'audio/webm' }[extension] ?? 'audio/mpeg');
---

<div class="audio-section">
  {embedUrl ? (
    <div class="audio-embed" style="margin-bottom: 1rem;">
      <iframe
        src={embedUrl}
        height={embedHeight}
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        title="Player audio"
      ></iframe>
    </div>
  ) : null}

  {directAudio && !embedUrl ? (
    <div class="audio-embed" style="padding:1rem; background:var(--bg-card);">
      <audio
        controls
        preload="metadata"
        data-dedication-audio
        data-audio-download-url={url}
        data-audio-filename={originalFilename || 'audio.mp3'}
        style="width:100%; accent-color:var(--purple-1);"
      >
        <source src={url} type={fallbackMime} />
        Il tuo browser non supporta l'audio HTML5.
      </audio>
      <button type="button" class="tool-button" data-audio-download style="margin-top:.75rem;"><Icon name="download" size={16} /> Scarica audio</button>
      <p data-audio-status role="status" aria-live="polite" style="font-size:.85rem;margin-top:.5rem;"></p>
    </div>
  ) : null}

  {!embedUrl && !directAudio ? (
    <div class="audio-embed" style="padding:1rem; background:var(--bg-card);">
      <p style="margin:0 0 .75rem; color:var(--text-dim);">Questa sorgente non è riproducibile direttamente nel browser.</p>
      <a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        Apri la sorgente{originalFilename ? `: ${originalFilename}` : ''}
      </a>
    </div>
  ) : null}
</div>

<script>
  import { notify } from '../scripts/experience.js';
  async function downloadAudioFile(url: string, filename: string) {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Download audio fallito: HTTP ${response.status}`);

    const blob = await response.blob();
    const blobUrl = URL.createObjectURL(blob);
    const downloadLink = document.createElement('a');
    downloadLink.href = blobUrl;
    downloadLink.download = filename || 'audio.mp3';
    downloadLink.hidden = true;
    document.body.appendChild(downloadLink);
    downloadLink.click();
    downloadLink.remove();
    window.setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
  }

  function bindAudioPlayButtons() {
    document.querySelectorAll('[data-audio-play]').forEach((button) => {
      if (!(button instanceof HTMLAnchorElement) || button.dataset.audioPlayBound === 'true') return;

      button.dataset.audioPlayBound = 'true';
      button.addEventListener('click', (event) => {
        const player = document.querySelector('[data-dedication-audio]');
        if (!(player instanceof HTMLAudioElement)) return;

        event.preventDefault();
        document.dispatchEvent(new Event('ddgpilli:foreground-audio'));
        if (!player.paused) { player.pause(); return; }
        const playback = player.play();
        if (playback) {
          playback.catch(() => {
            notify('Audio non avviato. Prova i controlli del player o verifica la connessione.');
            player.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'center' });
          });
        }
      });
    });
  }

  bindAudioPlayButtons();
  document.addEventListener('astro:page-load', bindAudioPlayButtons);
  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-audio-play]')) document.dispatchEvent(new Event('ddgpilli:foreground-audio'));
    const button = event.target.closest('[data-audio-download]');
    if (!(button instanceof HTMLButtonElement) || button.disabled) return;
    const player = button.closest('.audio-embed')?.querySelector('audio');
    const status = button.parentElement?.querySelector('[data-audio-status]');
    if (!player?.dataset.audioDownloadUrl) return;
    button.disabled = true;
    if (status) status.textContent = 'Preparazione del download…';
    try {
      await downloadAudioFile(player.dataset.audioDownloadUrl, player.dataset.audioFilename || 'audio.mp3');
      if (status) status.textContent = 'Download avviato.';
    } catch {
      if (status) status.textContent = 'Download non disponibile. Riprova quando la connessione è attiva.';
    } finally { button.disabled = false; }
  });
  document.addEventListener('play', (event) => {
    if (event.target instanceof HTMLMediaElement) document.dispatchEvent(new Event('ddgpilli:foreground-audio'));
  }, true);
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll('[data-dedication-audio]').forEach(player => {
      if (player instanceof HTMLAudioElement) player.pause();
    });
  });
</script>
