---
// src/components/DedicationImage.astro
// Full photo, preserving its original proportions and all edges.
export interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
  wrapClass?: string;
  wrapStyle?: string;
}

const {
  src,
  alt = '',
  width = 480,
  height = 600,
  class: className = '',
  style = '',
  loading = 'lazy',
  wrapClass = '',
  wrapStyle = '',
} = Astro.props;
---

<div class={`image-frame full-image ${wrapClass}`} style={wrapStyle}>
  <img
    src={`${src}${src.includes('?') ? '&' : '?'}view=full-archive-20261019`}
    alt={alt}
    width={width}
    height={height}
    class={`ded-image ${className}`}
    style={style}
    loading={loading}
    decoding="async"
  />
</div>
