---
export interface Props {
  type?: 'youtube' | 'mp4' | 'external' | string;
  url?: string;
  poster?: string;
  title?: string;
  description?: string;
  class?: string;
}

const {
  type = '',
  url = '',
  poster = '/images/og-default.png?v=ddgpillisite-video-poster-20260602',
  title = 'Video',
  description = '',
  class: className = '',
} = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/([^/])$/, '$1/');

function assetUrl(value: string) {
  if (!value) return base + 'images/og-default.png?v=ddgpillisite-video-poster-20260602';
  if (/^https?:\/\//.test(value)) return value;
  return base + value.replace(/^\//, '');
}

function getYoutubeId(value: string): string {
  try {
    const parsed = new URL(value);
    const host = parsed.hostname.replace(/^(www\.|m\.)/, '');
    const id = host === 'youtu.be' ? parsed.pathname.split('/')[1]
      : ['youtube.com', 'youtube-nocookie.com'].includes(host)
        ? parsed.searchParams.get('v') || parsed.pathname.match(/^\/(?:embed|shorts|live)\/([^/]+)/)?.[1]
        : '';
    return /^[a-zA-Z0-9_-]{11}$/.test(id || '') ? id! : '';
  } catch {
    return '';
  }
}

const normalizedType = type.toLowerCase();
const videoUrl = assetUrl(url);
const youtubeId = normalizedType === 'youtube' ? getYoutubeId(url) : '';
const defaultPoster = assetUrl('');
const posterSrc = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg` : assetUrl(poster);
const posterFallbacks = JSON.stringify(youtubeId
  ? [`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`, defaultPoster]
  : posterSrc === defaultPoster ? [] : [defaultPoster]);
const canRender = Boolean(normalizedType && url);
---

{canRender && (
  <section class={`video-card ${className}`} data-video-type={normalizedType}>
    <div class="video-card-copy">
      {title && <h2>{title}</h2>}
      {description && <p>{description}</p>}
    </div>

    {normalizedType === 'external' ? (
      <a
        class="video-poster"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Apri video esterno: ${title}`}
      >
        <img src={posterSrc} data-video-poster data-fallbacks={posterFallbacks} alt={title} loading="lazy" width="960" height="540" />
        <span class="video-play" aria-hidden="true">Play</span>
      </a>
    ) : (
      <button
        class="video-poster"
        type="button"
        data-video-loader
        data-video-type={normalizedType}
        data-video-url={normalizedType === 'youtube' ? youtubeId : videoUrl}
        data-video-title={title}
        aria-label={`Carica video: ${title}`}
      >
        <img src={posterSrc} data-video-poster data-fallbacks={posterFallbacks} alt={title} loading="lazy" width="960" height="540" />
        <span class="video-play" aria-hidden="true">Play</span>
      </button>
    )}
  </section>
)}

<script>
  function checkPoster(img: HTMLImageElement) {
    if (!img.complete) return;
    // YouTube can return a 120px placeholder with HTTP 200 for missing sizes.
    const missingYoutubeImage = img.src.startsWith('https://i.ytimg.com/') && img.naturalWidth <= 120;
    if (img.naturalWidth > 0 && !missingYoutubeImage) return;
    const fallbacks: string[] = JSON.parse(img.dataset.fallbacks || '[]');
    const next = fallbacks.shift();
    img.dataset.fallbacks = JSON.stringify(fallbacks);
    if (next) img.src = next;
    else img.style.visibility = 'hidden';
  }
  for (const eventName of ['load', 'error']) {
    document.addEventListener(eventName, (event) => {
      if (event.target instanceof HTMLImageElement && event.target.hasAttribute('data-video-poster')) checkPoster(event.target);
    }, true);
  }
  function checkPosters() {
    document.querySelectorAll<HTMLImageElement>('[data-video-poster]').forEach(checkPoster);
  }
  checkPosters();
  document.addEventListener('astro:page-load', checkPosters);

  function mountVideo(button) {
    const type = button.dataset.videoType;
    const url = button.dataset.videoUrl;
    const title = button.dataset.videoTitle || 'Video';
    if (!type || !url) return;

    let node;
    if (type === 'youtube') {
      node = document.createElement('iframe');
      node.src = `https://www.youtube.com/embed/${url}?rel=0&autoplay=0`;
      node.title = title;
      node.loading = 'lazy';
      node.allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      node.allowFullscreen = true;
    } else if (type === 'mp4') {
      node = document.createElement('video');
      node.controls = true;
      node.muted = true;
      node.playsInline = true;
      node.preload = 'metadata';
      node.poster = button.querySelector('img')?.currentSrc || '';
      const source = document.createElement('source');
      source.src = url;
      source.type = 'video/mp4';
      node.append(source);
    }

    if (!node) return;
    node.className = 'video-player';
    button.replaceWith(node);
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest('[data-video-loader]');
    if (!button) return;
    mountVideo(button);
  });
</script>
