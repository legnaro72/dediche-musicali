{
  "name": "ddgpillisite",
  "type": "module",
  "version": "0.1.0",
  "description": "Sito di dediche musicali giornaliere - DDGPilliSite",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "feedback-api": "python scripts/feedback_api.py",
    "worker:login": "npx wrangler login",
    "worker:deploy": "npx wrangler deploy --config workers/feedback-worker/wrangler.toml",
    "worker:dev": "npx wrangler dev --config workers/feedback-worker/wrangler.toml",
    "build": "astro build",
    "optimize:images": "python scripts/optimize_web_images.py",
    "preview": "astro preview",
    "test:unit": "node --test tests/mobile_photo.test.cjs",
    "test:browser": "node tests/navigation.browser.cjs && node tests/experience.browser.cjs",
    "test:offline": "node tests/offline.browser.cjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tsparticles/engine": "^4.1.3",
    "@tsparticles/slim": "^4.1.3",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
